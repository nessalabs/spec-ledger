{
  "name": "nessa-spec-test",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @nessalabs/spec-ledger test",
    "verify": "node packages/ledger/dist/cli/main.js verify --root .",
    "ledger:audit": "node packages/ledger/dist/cli/main.js audit --root .",
    "ledger:align": "node packages/ledger/dist/cli/main.js align check --root .",
    "lattice": "pnpm --filter @nessalabs/spec-ledger-ui dev",
    "lattice:prod": "pnpm --filter @nessalabs/spec-ledger-ui build && pnpm --filter @nessalabs/spec-ledger-ui start",
    "serve": "node packages/server/dist/main.js",
    "hooks:install": "git config core.hooksPath scripts/git-hooks && chmod +x scripts/git-hooks/commit-msg scripts/git-hooks/pre-commit scripts/git-hooks/pre-push && echo \"hooksPath=$(git config core.hooksPath)\""
  },
  "engines": {
    "node": ">=20"
  }
}
