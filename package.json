{
  "name": "nessa-spec-test",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm --filter @nessa/spec-ledger test",
    "verify": "node packages/ledger/dist/cli/main.js verify --root .",
    "lattice": "pnpm --filter @nessa/spec-ledger-ui dev",
