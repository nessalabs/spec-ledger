{
  "name": "@nessalabs/spec-ledger-server",
  "version": "0.1.0-alpha.0",
  "description": "Read-only HTTP projection of Spec Ledger (no write endpoints)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "spec-ledger-serve": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@nessalabs/spec-ledger": "0.1.0-alpha.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
