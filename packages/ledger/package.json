{
  "name": "@nessa/spec-ledger",
  "version": "0.1.0",
  "description": "Claim-adherence ledger: verify specs/ADRs/invariants against ingested evidence",
  "type": "module",
  "bin": {
    "spec-ledger": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
