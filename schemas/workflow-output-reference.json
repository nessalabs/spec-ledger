{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nessalabs.dev/spec-ledger/workflow-output-reference.schema.json",
  "title": "Spec Ledger workflow output reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "workstreamId",
    "attemptId",
    "kind",
    "recordType",
    "recordIds",
    "criterionIds",
    "snapshotDigest",
    "revisionDigest",
    "sourceDigest",
    "recordedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workstreamId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kind": {
      "enum": [
        "spec-revision",
        "spec-review",
        "implementation-report",
        "check-results",
        "code-review",
        "attestation"
      ]
    },
    "recordType": {
      "enum": [
        "snapshot",
        "review",
        "decision",
        "result"
      ]
    },
    "recordIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "criterionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "snapshotDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revisionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recordedAt": {
      "type": "string"
    },
    "migration": {
      "type": "object",
      "properties": {
        "origins": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "path",
              "id",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "historical": {
          "type": "boolean"
        }
      },
      "required": [
        "origins",
        "historical"
      ],
      "additionalProperties": false
    }
  }
}
