{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nessalabs.dev/spec-ledger/workflow-snapshot.schema.json",
  "title": "Spec Ledger resolved workflow snapshot",
  "type": "object",
  "required": ["schemaVersion", "snapshotId", "snapshotDigest", "workstreamId", "revisionDigest", "profile", "stages", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 }, "snapshotId": { "type": "string" }, "snapshotDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workstreamId": { "type": "string" }, "revisionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "profile": { "type": "object" }, "stages": { "type": "array", "minItems": 1 }, "createdAt": { "type": "string" },
    "reason": { "type": "string" }, "supersedesSnapshotDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
