{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "action",
    "source",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "action": {
      "enum": [
        "grant",
        "deny",
        "revoke",
        "restrict"
      ]
    },
    "mode": {
      "enum": [
        "revision",
        "request",
        "standing"
      ]
    },
    "workstreamId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "featureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excludeFeatureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revisionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "const": "agent-reported"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "migration": {
      "type": "object",
      "properties": {
        "origins": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "path",
              "id",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "historical": {
          "type": "boolean"
        }
      },
      "required": [
        "origins",
        "historical"
      ],
      "additionalProperties": false
    }
  }
}
