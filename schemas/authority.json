{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "action",
    "source",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^AUTH-[a-zA-Z0-9_-]+$"
    },
    "action": {
      "enum": [
        "grant",
        "deny",
        "revoke",
        "restrict"
      ]
    },
    "mode": {
      "enum": [
        "revision",
        "request",
        "standing"
      ]
    },
    "workstreamId": {
      "type": "string",
      "pattern": "^W-[0-9]{3,}$"
    },
    "featureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excludeFeatureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revisionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "const": "agent-reported"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
