{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nessalabs.ai/spec-ledger/schemas/layer-policy.json",
  "title": "LayerPolicy",
  "description": "Per-repo layer allowlist. Mechanism is generic; names are data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["layers", "allow"],
  "properties": {
    "layers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Declared layer ids (order is display-only)."
    },
    "allow": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      },
      "description": "Map fromLayer → list of toLayers that are legal dependencies."
    }
  }
}
