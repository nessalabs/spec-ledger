{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nessalabs.ai/spec-ledger/schemas/attachment.json",
  "title": "Attachment",
  "description": "Episode artifact metadata. Bodies live beside the JSON (or as a path ref). Image/video kinds are for code-review media; Spec Ledger does not host binary media — store a path/URL ref only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "turnId", "path"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "turnId": { "type": "string", "pattern": "^T-" },
    "kind": {
      "type": "string",
      "enum": [
        "prompt",
        "rationale",
        "log-excerpt",
        "diff-note",
        "image",
        "video",
        "image-ref",
        "other"
      ]
    },
    "title": { "type": "string" },
    "mediaType": {
      "type": "string",
      "description": "IANA media type, e.g. image/png, video/mp4"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Repo-relative path or external ref URL; not a hosted blob store"
    },
    "byteLength": { "type": "integer", "minimum": 0 },
    "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "note": { "type": "string" },
    "decisionId": { "type": "string" },
    "sourceId": { "type": "string" },
    "probeId": { "type": "string" },
    "reviewId": { "type": "string" },
    "flowId": { "type": "string" }
  }
}
