{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "statement",
    "source",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^LN-[a-zA-Z0-9_-]+$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "workstreamId": {
      "type": "string",
      "minLength": 1
    },
    "featureIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedesTenetIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "user-reported",
            "agent-inferred"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
