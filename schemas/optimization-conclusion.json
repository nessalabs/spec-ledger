{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "goalId": {
      "type": "string",
      "pattern": "^G-[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "turnId": {
      "type": "string",
      "pattern": "^T-[0-9]{3,}$"
    },
    "reason": {
      "type": "string",
      "enum": [
        "satisfied",
        "budget",
        "stopped"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revisionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "goalId",
    "turnId",
    "reason",
    "summary",
    "schemaVersion",
    "createdAt",
    "sourceDigest",
    "revisionDigest"
  ],
  "additionalProperties": false,
  "$id": "https://nessalabs.ai/spec-ledger/schemas/optimization-conclusion.json",
  "description": "Optional iterative work history. Agent-reported observations never affect verification. Runtime validates cross-record references and current task permission."
}
