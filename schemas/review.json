{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nessalabs.ai/spec-ledger/schemas/review.json",
  "title": "Review",
  "description": "Human/agent review of a turn (code) or workstream (spec). Immutable resolution — do not mutate blocking findings away.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "reviewer", "verdict", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "turnId": { "type": "string", "pattern": "^T-" },
    "workstreamId": { "type": "string", "pattern": "^W-" },
    "kind": { "type": "string", "enum": ["human", "adversarial", "discussion"] },
    "target": { "type": "string", "enum": ["spec", "code"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "verdict": {
      "type": "string",
      "enum": ["approve", "request-changes", "comment"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "blocking": { "type": "boolean" },
    "killersCited": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "gap"],
        "properties": {
          "id": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "moderate", "high", "critical"]
          },
          "claimId": { "type": "string" },
          "gap": { "type": "string" },
          "fixProposal": { "type": "string" },
          "evidencePath": { "type": "string" },
          "evidence": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "resolvesReviewId": { "type": "string" },
    "supersedesReviewId": { "type": "string" },
    "resolvesFindingIds": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
