{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nessalabs.ai/spec-ledger/schemas/binding.json",
  "title": "EvidenceBinding",
  "description": "Committed intent to check a claim. Never carries pass/fail status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "claimId",
    "kind",
    "locator"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "test",
        "check",
        "contract",
        "proof",
        "attestation"
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "results-row",
            "command",
            "path",
            "attestation"
          ]
        },
        "resultsKey": {
          "type": "string",
          "description": "Key matched in an ingested results file (claimId or custom)."
        },
        "command": {
          "type": "string",
          "description": "Shell command for kind=check (coarse).",
          "maxLength": 16384
        },
        "path": {
          "type": "string",
          "description": "Path that must exist (graph honesty)."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "unit",
            "integration",
            "e2e",
            "property",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "name": {
              "type": "string",
              "maxLength": 500
            }
          }
        },
        "inputs": {
          "type": "string",
          "maxLength": 4000
        },
        "expected": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "origins": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "path",
              "id",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "historical": {
          "type": "boolean"
        }
      },
      "required": [
        "origins",
        "historical"
      ],
      "additionalProperties": false
    }
  }
}
