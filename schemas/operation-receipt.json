{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nessalabs.ai/spec-ledger/schemas/operation-receipt.json",
  "title": "Application operation receipt",
  "oneOf": [
    { "$ref": "#/$defs/started" },
    { "$ref": "#/$defs/finished" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schemaVersion", "requestId", "operation", "inputDigest"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{15,79}$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "inputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "invalid_input", "not_found", "permission_denied",
            "prerequisite_missing", "revision_conflict", "source_conflict",
            "idempotency_conflict", "execution_unknown", "operation_busy",
            "operation_failed"
          ]
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": true
      }
    },
    "started": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["startedAt"],
          "properties": {
            "schemaVersion": true,
            "requestId": true,
            "operation": true,
            "inputDigest": true,
            "startedAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "finished": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["finishedAt", "outcome"],
          "properties": {
            "schemaVersion": true,
            "requestId": true,
            "operation": true,
            "inputDigest": true,
            "finishedAt": { "type": "string", "format": "date-time" },
            "outcome": { "enum": ["succeeded", "failed"] },
            "result": true,
            "error": { "$ref": "#/$defs/error" }
          },
          "allOf": [
            {
              "if": { "properties": { "outcome": { "const": "succeeded" } } },
              "then": { "required": ["result"] },
              "else": { "required": ["error"] }
            }
          ]
        }
      ]
    }
  }
}
