  "intent": {
    "userPrompt": "Build Spec Ledger as a generic claim-adherence gate plus Lattice viewing layer, then add turns information and commit what we've built.",
    "restatedGoal": "Ship Spec Ledger core (claims/bindings/verify/graph), read-only server + client, Lattice UI, and a turns change-log whose facts come from turn close — not agent self-report.",
    "acceptanceCriteria": [
      "Verify is a pure function of ledger + tree + results with digests",
      "Server is GET-only (SL-003)",
      "Lattice shows claims, contracts, graph, verify, and turns",
      "turn close writes git files + verify digests into the turn"
    ],
    "outOfScope": [
      "AST graph extraction",
      "Server write APIs",
      "SaaS multi-tenant",
      "Z3 / formal proofs"
    ],
    "changeType": "feature",
    "riskLevel": "moderate",
    "claimedFeatureIds": [
