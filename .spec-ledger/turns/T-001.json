      "SL-005"
    ],
    "decisions": [
      {
        "decision": "Split turn intent (agent) from turn facts (tool)",
        "rationale": "Fable: if the agent also writes digests and blast radius, autonomy will lie. turn close owns facts.",
        "alternativesRejected": [
          "Atlas-style single manifest where agent fills everything"
        ]
      },
      {
        "decision": "UI depends only on @nessa/spec-ledger-client",
        "rationale": "Keep the Nessa embed pattern: replaceable Lattice; products never import core FS."
      }
    ],
    "flows": [
      {
        "id": "enforcement",
        "title": "Enforcement loop",
        "kind": "flowchart",
        "narrative": "Claims stay standing truth; each turn records intent and closes with tool facts.",
        "after": "flowchart TD\n  A[Author claims + bindings] --> B[Agent implements]\n  B --> C[spec-ledger turn close]\n  C --> D[git files + verify digests]\n  D --> E{verify OK?}\n  E -->|yes| F[Commit turn + code]\n  E -->|no| B\n  F --> G[Lattice change log]"
      }
    ],
    "summaryForSearch": "Initial Spec Ledger scaffold with turns change log",
    "keywords": [
      "spec-ledger",
      "verify",
      "turns",
      "lattice",
      "claim"
    ]
  },
