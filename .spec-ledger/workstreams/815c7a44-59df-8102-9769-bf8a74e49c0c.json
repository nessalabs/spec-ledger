    {
      "id": "25eac677-2871-816d-956d-770bdcb61798",
      "title": "Follow a chosen method and inspect its evidence",
      "kind": "vertical",
      "acceptance": [
        "Default and custom local methods preserve snapshots, enforce typed output gates and show live progress and inspectable evidence in the UI.",
        "Passing checks cannot produce 100% while any required implementation, review, permission, deferred obligation, screenshot, workflow output, or turn-closure task remains incomplete.",
        "The progress count covers the applicable completion checklist, counts grouped tasks consistently, avoids counting the same diagnostic twice, and reaches 100% only when the shared completion gate allows completion.",
        "Overview and spec details show consistent completion progress; evidence counts stay separate, missing scope is indeterminate, and historical completion stays distinct from current rechecking."
      ],
      "expectedPaths": [
        "packages/**",
        "schemas/**",
        "docs/**",
        "skills/**"
      ],
      "evidence": [
        "unit",
        "integration",
        "e2e",
        "screenshot"
      ],
      "codeBreakReviewId": "b2307aae-74e4-4f06-a043-90005a52bfca"
    },
    {
      "id": "87ce7ed9-a607-8425-a475-173f8953ffaf",
      "title": "Track activity without inventing completion",
      "kind": "vertical",
      "acceptance": [
        "Execution associations and bounded activity handle missing and duplicated signals honestly; optional recovery readiness honors policy and available host capabilities."
      ],
      "expectedPaths": [
        "packages/**",
        "schemas/**",
        "docs/**",
        "skills/**",
        ".gitignore"
      ],
      "evidence": [
        "unit",
        "integration",
        "e2e"
      ],
      "codeBreakReviewId": "9d79e552-50e2-8cfc-aaa2-d5d6f1e80ba0"
    }
  ],
