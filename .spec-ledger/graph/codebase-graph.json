{
  "system": {
    "name": "Spec Ledger",
    "description": "Generic claim-adherence gate + replaceable Spec Ledger UI viewing layer.",
    "revision": "0.1.0",
    "languages": [
      "typescript"
    ]
  },
  "layers": [
    {
      "id": "schemas",
      "name": "Schemas",
      "blurb": "JSON Schema SSOT"
    },
    {
      "id": "core",
      "name": "Core",
      "blurb": "Verify + graph algorithms + CLI"
    },
    {
      "id": "client",
      "name": "Client",
      "blurb": "Typed SDK — only gateway for UIs"
    },
    {
      "id": "server",
      "name": "Server",
      "blurb": "Read-only HTTP projection"
    },
    {
      "id": "adapters",
      "name": "Agent adapters",
      "blurb": "CLI/MCP transports over shared application operations"
    },
    {
      "id": "ui",
      "name": "UI",
      "blurb": "Reference Spec Ledger UI — replaceable"
    }
  ],
  "features": [
    {
      "id": "verify",
      "name": "Claim verification",
      "summary": "Bindings + ingested results → provenance-bearing report.",
      "claimIds": [
        "SL-001",
        "SL-002",
        "SL-003",
        "SL-008",
        "SL-016",
        "SL-017",
        "SL-018"
      ],
      "entryPoints": [
        "packages/ledger/src/verify/verify.ts"
      ],
      "keywords": [
        "verify",
        "claim",
        "evidence",
        "digest"
      ]
    },
    {
      "id": "lattice",
      "name": "Spec Ledger UI",
      "summary": "Feature/module graph, blast radius, layer policy, and Spec Ledger viewing surface.",
      "claimIds": [
        "SL-004",
        "SL-021",
        "SL-022"
      ],
      "entryPoints": [
        "packages/ledger/src/graph/impact.ts",
        "packages/ui"
      ],
      "keywords": [
        "graph",
        "blast radius",
        "layers",
        "spec ledger",
        "ui"
      ]
    },
    {
      "id": "turns",
      "name": "Turn change log",
      "summary": "Intent authored; facts from turn close (git + verify digests).",
      "claimIds": [
        "SL-001",
        "SL-003",
        "SL-006",
        "SL-020"
      ],
      "entryPoints": [
        "packages/ledger/src/turns/close.ts"
      ],
      "keywords": [
        "turn",
        "change log",
        "intent",
        "facts"
      ]
    },
    {
      "id": "client",
      "name": "Typed client",
      "summary": "Transport-agnostic SDK — only gateway for UIs.",
      "claimIds": [
        "SL-003"
      ],
      "entryPoints": [
        "packages/client/src/index.ts"
      ],
      "keywords": [
        "client",
        "sdk",
        "http"
      ]
    },
    {
      "id": "server",
      "name": "Read-only HTTP",
      "summary": "GET-only projection of the ledger (SL-003).",
      "claimIds": [
        "SL-003",
        "SL-007"
      ],
      "entryPoints": [
        "packages/server/src/routes.ts"
      ],
      "keywords": [
        "server",
        "http",
        "readonly"
      ]
    },
    {
      "id": "cli",
      "name": "Consumer CLI",
      "summary": "CLI and local MCP adapters over shared work, evidence and completion operations.",
      "claimIds": [
        "SL-011",
        "SL-015",
        "SL-019",
        "SL-023"
      ],
      "entryPoints": [
        "packages/ledger/src/cli/main.ts",
        "packages/ledger/src/cli/init.ts",
        "packages/ledger/package.json",
        "packages/client/package.json",
        "packages/server/package.json",
        "packages/ui/package.json",
        ".github/workflows/publish.yml",
        "packages/ledger/src/application/index.ts"
      ],
      "keywords": [
        "cli",
        "init",
        "npm",
        "bin",
        "release"
      ]
    }
  ],
  "nodes": [
    {
      "id": "schemas",
      "name": "schemas/",
      "layer": "schemas",
      "kind": "package",
      "locator": "schemas",
      "purpose": "JSON Schema SSOT"
    },
    {
      "id": "ledger-core",
      "name": "@nessalabs/spec-ledger",
      "layer": "core",
      "kind": "package",
      "locator": "packages/ledger",
      "featureIds": [
        "verify",
        "lattice",
        "turns",
        "cli"
      ],
      "purpose": "Core verify + CLI"
    },
    {
      "id": "ledger-client",
      "name": "@nessalabs/spec-ledger-client",
      "layer": "client",
      "kind": "package",
      "locator": "packages/client",
      "purpose": "Embeddable typed client"
    },
    {
      "id": "ledger-server",
      "name": "@nessalabs/spec-ledger-server",
      "layer": "server",
      "kind": "package",
      "locator": "packages/server",
      "purpose": "Read-only HTTP API"
    },
    {
      "id": "ledger-ui",
      "name": "@nessalabs/spec-ledger-ui",
      "layer": "ui",
      "kind": "package",
      "locator": "packages/ui",
      "featureIds": [
        "lattice"
      ],
      "purpose": "Spec Ledger UI — presentation only"
    },
    {
      "id": "ledger-mcp",
      "name": "@nessalabs/spec-ledger-mcp",
      "layer": "adapters",
      "kind": "package",
      "locator": "packages/mcp",
      "featureIds": [
        "cli"
      ],
      "purpose": "Local stdio transport for shared work and evidence operations"
    }
  ],
  "edges": [
    {
      "from": "ledger-core",
      "to": "schemas",
      "kind": "depends_on"
    },
    {
      "from": "ledger-client",
      "to": "schemas",
      "kind": "depends_on"
    },
    {
      "from": "ledger-server",
      "to": "ledger-core",
      "kind": "depends_on"
    },
    {
      "from": "ledger-server",
      "to": "schemas",
      "kind": "depends_on"
    },
    {
      "from": "ledger-ui",
      "to": "ledger-client",
      "kind": "depends_on"
    },
    {
      "from": "ledger-mcp",
      "to": "ledger-core",
      "kind": "depends_on"
    }
  ]
}
